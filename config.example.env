# Example configuration for /etc/rockpi-penta.env
# Values are written by install.sh. Edit /etc/rockpi-penta.env after install if needed.

# Use hardware PWM instead of GPIO bit-banging.
HARDWARE_PWM=1

# Fan PWM path for Cubie A7A pin 13 / S-PWM0-4:
# /sys/class/pwm/pwmchip20/pwm4
PWMCHIP=20
PWM_CHANNEL=4

# The tested Penta HAT fan input behaves active-low with rockpi-penta's fan curve.
# Linux PWM sysfs accepts: normal, inversed
PWM_POLARITY=inversed

# PWM period in microseconds. 40 us = 25 kHz, a typical quiet fan PWM frequency.
PWM_PERIOD_US=40

# OLED on Cubie pins 3/5 via TWI7.
I2C_BUS=7
OLED_ADDR=0x3c
OLED_WIDTH=128
OLED_HEIGHT=32

# Button mapping placeholder. The current OLED/fan patch does not depend on the button.
BUTTON_CHIP=0
BUTTON_LINE=33

# Fan control
# Final fan speed is the maximum requested speed from CPU and hottest drive.
FAN_INTERVAL=2
FAN_CPU_ENABLE=1
FAN_DRIVE_ENABLE=1
FAN_DRIVE_INTERVAL=10

# CPU temperature thresholds in °C
FAN_CPU_LV0=35
FAN_CPU_LV1=45
FAN_CPU_LV2=60
FAN_CPU_LV3=75

# Drive temperature thresholds in °C
FAN_DRIVE_LV0=35
FAN_DRIVE_LV1=45
FAN_DRIVE_LV2=55
FAN_DRIVE_LV3=65
